{
  "project": "ai-dev-kit",
  "projectType": "library",
  "ecosystem": {
    "runtime": "node"
  },
  "verify": {
    "build": "node install.mjs --adapter adapters/ai-dev-kit.json --hooks",
    "run": "node install.mjs --check",
    "ready": { "kind": "exit-code" },
    "observe": [
      "node .github/smoke-hooks.mjs",
      "node .github/smoke-installer.mjs"
    ],
    "notes": "The kit's live loop is its own install: self-install, drift-check, then the smoke suites drive every handler and installer path."
  },
  "gate": [
    "node install.mjs --check",
    "node .github/skill-lint.mjs",
    "node .github/skill-evals.mjs",
    "node .github/smoke-hooks.mjs",
    "node .github/smoke-installer.mjs",
    "node .github/check-version.mjs"
  ],
  "docs": {
    "dir": "docs",
    "status": "README.md",
    "backlog": "docs/BACKLOG.md",
    "archiveDir": "docs/archive"
  },
  "commit": {
    "style": "conventional subject + prose body (what/why + verification note)",
    "trailers": true,
    "useFileFlag": true
  },
  "ci": {
    "provider": "github-actions",
    "workflow": "CI"
  }
}
