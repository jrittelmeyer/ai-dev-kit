{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/compact-reorient.mjs"],
            "timeout": 10,
            "statusMessage": "ai-dev-kit: compact reorient"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/live-verify-reminder.mjs"],
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "ai-dev-kit: live-verify reminder"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/live-verify-reminder.mjs"],
            "if": "PowerShell(git *)",
            "timeout": 10,
            "statusMessage": "ai-dev-kit: live-verify reminder"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/skill-drift-guard-preedit.mjs"],
            "timeout": 10,
            "statusMessage": "ai-dev-kit: skill-drift guard (pre-edit)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/script-exec-guard.mjs"],
            "timeout": 10,
            "statusMessage": "ai-dev-kit: script-exec guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/dep-check-nudge.mjs"],
            "timeout": 10,
            "statusMessage": "ai-dev-kit: dep-check nudge"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/skill-drift-guard.mjs"],
            "timeout": 10,
            "statusMessage": "ai-dev-kit: skill-drift guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/context-guard.mjs"],
            "timeout": 10,
            "statusMessage": "ai-dev-kit: context guard"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/banned-api-guard.mjs"],
            "timeout": 10,
            "statusMessage": "ai-dev-kit: banned-api guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop-gate.mjs"],
            "timeout": 300,
            "asyncRewake": true,
            "statusMessage": "ai-dev-kit: stop gate"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/checkpoint-autorun.mjs"],
            "timeout": 30,
            "statusMessage": "ai-dev-kit: checkpoint autorun"
          }
        ]
      }
    ]
  }
}
